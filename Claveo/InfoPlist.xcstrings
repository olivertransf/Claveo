    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo uses the camera to photograph the edition you are practicing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo usa la cámara para fotografiar la edición que estás practicando."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo uses speech recognition to turn practice voice memos into notes. The transcript may be inaccurate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo usa el reconocimiento de voz para convertir las notas de voz de práctica en notas. La transcripción puede ser inexacta."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo needs access to your microphone to record practice sessions, voice memos, and detect pitch for tuning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo necesita acceso a tu micrófono para grabar sesiones de práctica, notas de voz y detectar la afinación."
          }
        }
      }
    }
  },
  "version" : "1.0"

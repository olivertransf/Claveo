    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo does not access your camera. This permission may be referenced by audio processing libraries but is not used by the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo no accede a tu cámara. Este permiso puede aparecer por bibliotecas de procesamiento de audio, pero la app no lo usa."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo needs access to your microphone to record practice sessions and detect pitch for tuning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claveo necesita acceso a tu micrófono para grabar sesiones de práctica y detectar la afinación."
          }
        }
      }
    }
  },
  "version" : "1.0"

    "1 is the tonic (home note). 5 is the dominant — it often leads back to 1. 7 is the leading tone, a half step below the tonic.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 es la tónica (nota de reposo). 5 es la dominante: suele conducir de nuevo a 1. 7 es la sensible, un semitono por debajo de la tónica."
          }
        }
      }
    },
